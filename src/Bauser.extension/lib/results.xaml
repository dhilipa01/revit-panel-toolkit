<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bauser" Height="600" Width="880" MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8"
        FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E6EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#14213D"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B778C"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14213D" Padding="24,18">
            <StackPanel>
                <TextBlock x:Name="title" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="subtitle" Foreground="#A9B4C7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#F2A900"/>

        <Grid Grid.Row="2" Margin="18,16,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="v1" Style="{StaticResource CardValue}"/>
                    <TextBlock x:Name="l1" Style="{StaticResource CardLabel}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="v2" Style="{StaticResource CardValue}"/>
                    <TextBlock x:Name="l2" Style="{StaticResource CardLabel}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="v3" Style="{StaticResource CardValue}"/>
                    <TextBlock x:Name="l3" Style="{StaticResource CardLabel}"/>
                </StackPanel>
            </Border>
        </Grid>

        <DataGrid Grid.Row="3" x:Name="grid" Margin="24,8,24,8"
                  IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E8ECF0" BorderBrush="#E1E6EC" Background="White"
                  AlternatingRowBackground="#F7F9FB" RowHeight="28" ColumnWidth="*"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,18">
            <TextBlock x:Name="footnote" Foreground="#6B778C" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="btn_budget" Content="Export budget CSV" Style="{StaticResource Btn}" Visibility="Collapsed"/>
            <Button x:Name="btn_export" Content="Export CSV" Style="{StaticResource Btn}"/>
            <Button x:Name="btn_close" Content="Close" Style="{StaticResource Btn}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
